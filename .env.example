# Copy this file to .env and set your MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/library-catalog
# Replace with a random secret containing at least 32 characters.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
# Optional: defaults to 14 days. Set to 0 only for a local late-fine demo.
LOAN_PERIOD_DAYS=14
